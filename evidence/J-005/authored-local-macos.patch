diff --git a/docs/31-MACOS-X64-DISTRIBUTION.md b/docs/31-MACOS-X64-DISTRIBUTION.md
new file mode 100644
index 0000000..cae4f47
--- /dev/null
+++ b/docs/31-MACOS-X64-DISTRIBUTION.md
@@ -0,0 +1,33 @@
+# macOS x64 distribution boundary
+
+J-005 packages a native x86_64 Mach-O and routes lifecycle requests through
+`axiom-cli` to the `axiom` installation engine. The adapters do not contain a
+second payload copier, uninstaller, service manager, or update implementation.
+
+The available install interface is complete enough for a local verified bundle:
+
+```text
+axiom install plan --bundle <verified-local-bundle> --out <engine-plan.json>
+axiom install apply --plan <engine-plan.json> --approve-digest <engine-plan-digest>
+```
+
+The reviewed engine plan declares executable core rows with `permissions`
+containing `read` and `execute`. The installer enforces the permissions that
+the reviewed plan declares, including executable mode after activation. The CLI
+provides verified bytes and invokes those argv forms without a shell string.
+
+Two engine library surfaces already exist but lack CLI composition. They are
+the minimal work needed for a complete macOS lifecycle:
+
+| Need | Reusable engine API | Missing binding |
+| --- | --- | --- |
+| Per-user launchd registration | `service::macos::plan_agent`, `install_agent`, `start_operation`, `stop_operation`, `status_operation` | Implement `axiom service install/start/stop/status --component … --user` instead of its current NotReady dispatcher entry. It must accept only a per-user home and an engine-owned executable path. |
+| Owned launchd removal | `service::macos::plan_removal` | Implement `axiom service uninstall --component … --user`; execute only the owned plist/label plan. |
+| Component removal | no ecosystem removal transaction exists | Add an engine `uninstall plan/apply` pair that binds the approved digest to owned generation and service paths, preserves data by default, and makes purge a separate approval. |
+
+Until those bindings exist, the macOS wrappers report NotReady for service or
+removal work. They never create a plist, call `launchctl`, or delete user data
+to simulate completion. A locally trusted development bundle can exercise the
+engine in an isolated test root; a production update or rollback needs the
+owner's real signed/published channel and component artifacts. The current
+development channel is not such a release.
diff --git a/installers/macos/Install-AxiomCli.sh b/installers/macos/Install-AxiomCli.sh
new file mode 100755
index 0000000..c87298d
--- /dev/null
+++ b/installers/macos/Install-AxiomCli.sh
@@ -0,0 +1,60 @@
+#!/bin/sh
+# macOS x64 distribution wrapper (J-005).
+#
+# This is intentionally only an argv adapter. `axiom-cli` verifies the release
+# set and calls the axiom-graphd-owned installation engine; this script neither
+# copies payloads nor implements a second installer transaction.
+
+set -eu
+
+[ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "x86_64" ] || {
+    printf '%s\n' 'Install-AxiomCli.sh supports native macOS x64 only' >&2
+    exit 9
+}
+
+usage() {
+    cat <<'USAGE'
+Usage: Install-AxiomCli.sh --cli FILE --from RELEASE_SET (--dry-run | --apply) [--approve-digest SHA256]
+
+This wrapper invokes FILE install with program-and-argv.  It writes no system
+directory and does not invoke sudo. The target per-user root is selected by
+AXIOM_CLI_INSTALL_ROOT. launchd registration is engine-owned: until the engine
+publishes a runnable service transaction, request it separately and treat its
+not-ready result as no registration.
+USAGE
+}
+
+CLI=""
+FROM=""
+MODE=""
+APPROVAL=""
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        --cli|--from|--approve-digest)
+            [ "$#" -ge 2 ] || { printf '%s\n' "missing value for $1" >&2; exit 2; }
+            case "$1" in
+                --cli) CLI=$2 ;;
+                --from) FROM=$2 ;;
+                --approve-digest) APPROVAL=$2 ;;
+            esac
+            shift 2 ;;
+        --dry-run|--apply)
+            [ -z "$MODE" ] || { printf '%s\n' 'choose exactly one mode' >&2; exit 2; }
+            MODE=$1; shift ;;
+        --help|-h) usage; exit 0 ;;
+        *) printf '%s\n' "unknown option: $1" >&2; exit 2 ;;
+    esac
+done
+[ -n "$CLI" ] && [ -x "$CLI" ] || { printf '%s\n' '--cli must name an executable axiom-cli' >&2; exit 3; }
+case "$CLI" in
+    /*) ;;
+    */*) CLI="$(CDPATH= cd -- "$(dirname -- "$CLI")" && pwd)/$(basename -- "$CLI")" ;;
+    *) CLI="$(pwd)/$CLI" ;;
+esac
+[ -n "$FROM" ] || { printf '%s\n' '--from is required' >&2; exit 2; }
+[ -n "$MODE" ] || { printf '%s\n' 'choose --dry-run or --apply' >&2; exit 2; }
+if [ "$MODE" = '--apply' ]; then
+    [ -n "$APPROVAL" ] || { printf '%s\n' '--apply requires --approve-digest' >&2; exit 2; }
+    exec "$CLI" install --from "$FROM" --apply --approve-digest "$APPROVAL" --json
+fi
+exec "$CLI" install --from "$FROM" --dry-run --json
diff --git a/installers/macos/Uninstall-AxiomCli.sh b/installers/macos/Uninstall-AxiomCli.sh
new file mode 100755
